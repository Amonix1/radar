DATABASE_URL=postgresql://radar:CHANGE_ME@127.0.0.1:55432/radar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=radar
POSTGRES_DB=radar
SYNC_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
SYNC_INTERVAL_HOURS=24
PORT=3100
APP_PASSWORD_HASH=GENERATE_WITH_npm_run_access_configure
APP_SESSION_SECRET=GENERATE_WITH_npm_run_access_configure
# Local HTTP only; cloud startup derives HTTPS origin from RENDER_EXTERNAL_HOSTNAME.
APP_ORIGIN=http://127.0.0.1:3100
